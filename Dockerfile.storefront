FROM node:22-bookworm-slim

WORKDIR /workspace
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0

RUN corepack enable

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json ./
COPY apps/backend/package.json apps/backend/package.json
COPY apps/storefront/package.json apps/storefront/package.json
RUN pnpm install --frozen-lockfile

COPY . .
COPY ./docker/entrypoint-storefront.sh /usr/local/bin/entrypoint-storefront
COPY ./docker/entrypoint-storefront.sh /usr/local/bin/entrypoint-storefront.sh
RUN chmod 755 /usr/local/bin/entrypoint-storefront /usr/local/bin/entrypoint-storefront.sh \
    && test -f /usr/local/bin/entrypoint-storefront \
    && test -x /usr/local/bin/entrypoint-storefront
WORKDIR /workspace/apps/storefront

ENV NODE_ENV=development
EXPOSE 8000
ENTRYPOINT ["/usr/local/bin/entrypoint-storefront"]
